VITE_CHAT_API_URL=/.netlify/functions/chat

VITE_SOS_API_URL=http://localhost:3001
VITE_TRACKING_API_URL=http://localhost:3002
VITE_NOTIFICATION_API_URL=http://localhost:3004
VITE_AI_API_URL=http://localhost:8000

# Optional: required only when SOS endpoint enforces JWT auth.
VITE_AUTH_TOKEN=

# Defaults already match backend fallbacks, override for production.
VITE_INTERNAL_SERVICE_KEY=emergix_internal_secret
VITE_AI_API_KEY=emergix_service_secret

# Demo UUID used by SOS service trigger payload.
VITE_DEMO_USER_ID=00000000-0000-0000-0000-000000000001
